# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
.pub-cache/
.pub/
/build/
/coverage/

# Generated from lib/l10n/*.arb by `flutter gen-l10n` (runs automatically
# before build/run/test/analyze because pubspec.yaml sets flutter.generate:
# true) -- the .arb sources are tracked, this output is not.
/lib/l10n/app_localizations*.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

