# Copy this file to .env (git-ignored) and fill in your own values.
# flutter reads .env at build time, and scripts\build_local.ps1 compiles it in.
# Never put these values in the repository secret DOTENV_CONTENTS: anything in
# it ships in every published binary.

# Required by scripts\build_local.ps1.
TMDB_API_KEY=
WYZIE_API_KEY=
SIMKL_CLIENT_ID=
DROPBOX_APP_KEY=

# Linked accounts. Filled in once by scripts\link_simkl.ps1 and
# scripts\link_dropbox.ps1; a build without them asks for one sign-in per device.
SIMKL_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=

# Seals the cloud copy of the profile, so a new install opens it without asking.
# Anyone who has a build with this value can open that copy: keep builds private.
# It cannot be recovered if lost.
BACKUP_PASSPHRASE=

# Optional. Trakt sync is switched off in this version.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
