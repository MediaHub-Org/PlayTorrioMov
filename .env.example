# Copy this file to .env (git-ignored) and fill in your own values.
# flutter reads .env at build time, and scripts\build_local.ps1 compiles it in.
# Never put these values in the repository secret DOTENV_CONTENTS: anything in
# it ships in every published binary.

# Required by scripts\build_local.ps1.
TMDB_API_KEY=
WYZIE_API_KEY=
SIMKL_CLIENT_ID=

# Profile sync: a fine-grained GitHub token whose only permission is
# Account > Gists (read and write). It holds the encrypted profile in a secret
# gist of your own account, and cannot touch any repository.
GITHUB_SYNC_TOKEN=

# Seals the profile before it leaves the device. Anyone who has a build with
# this value can open the gist: keep builds private. It cannot be recovered if
# lost, so keep a copy of this file.
BACKUP_PASSPHRASE=

# Linked by scripts\link_simkl.ps1 (one approval at simkl.com/pin). A build
# without it asks for one Simkl sign-in per device.
SIMKL_ACCESS_TOKEN=

# Optional. Trakt sync is switched off in this version.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
